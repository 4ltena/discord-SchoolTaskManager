# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token

# Discord Server (Guild) ID
DISCORD_GUILD_ID=your_guild_id

# Channel ID where auto-cleanup messages are sent
DISCORD_CHANNEL_ID=your_channel_id

# Comma-separated user IDs with admin privileges (for /reboot)
DISCORD_ADMIN_IDS=your_user_id

# Google Calendar ID ('primary' or a specific calendar ID)
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Google service account credentials as single-line JSON
# Generate at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Download the JSON key and paste its contents here (minified to one line)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n","client_email":"YOUR@YOUR_PROJECT.iam.gserviceaccount.com","client_id":"CLIENT_ID","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/YOUR%40YOUR_PROJECT.iam.gserviceaccount.com","universe_domain":"googleapis.com"}

# Timezone (IANA format)
TIMEZONE=Asia/Tokyo

# GitHub repo for /gitlatest command (format: owner/repo)
GITHUB_REPO=owner/repo
# GITHUB_TOKEN=your_github_token  # required for private repos only
